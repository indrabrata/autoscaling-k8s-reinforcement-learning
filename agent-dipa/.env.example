PROMETHEUS_URL=

METRICS_ENDPOINTS_METHOD=[["/cpu","POST"],["/memory","POST"]]
METRICS_INTERVAL=45
METRICS_QUANTILE=0.90

# One of: Q-LEARNING | Q-LEARNING-CRISP | Q-LEARNING-FUZZY
# Must match DEPLOYMENT_NAME below - each agent trains against its own deployment.
ALGORITHM=Q-LEARNING-FUZZY

LEARNING_RATE=0.01
DISCOUNT_FACTOR=0.95
EPSILON_START=0.90
EPSILON_DECAY=0.99
EPSILON_MIN=0.1

EPISODES=300
ITERATION=30

NOTE=
RESUME=False
RESUME_PATH=
RESET_EPSILON=False
AUTO_RESUME=False
MAX_SCALING_RETRIES=1000

MIN_REPLICAS=1
MAX_REPLICAS=10
NAMESPACE=default
# resource-intensive-q | resource-intensive-qcrisp | resource-intensive-qfuzzy
DEPLOYMENT_NAME=resource-intensive-qfuzzy
MAX_RESPONSE_TIME=1000  # Maximum acceptable response time in milliseconds (P90)
TIMEOUT=120  # Timeout for Kubernetes operations in seconds
WAIT_TIME=45  # Wait time after scaling for metrics to stabilize in seconds

LOG_LEVEL=INFO

# Required by test_model.py only
MODEL_PATH=
COLLECT_INTERVAL=15
